# ---------------------------------------------------------------------------
# oilspill — environment configuration. Copy to .env and edit.
# ---------------------------------------------------------------------------

# Root for large derived artifacts (tiles, caches, warped scenes).
# Keep this OUTSIDE OneDrive/Dropbox — it will hold many GB.
OILSPILL_DATA_DIR=C:/oilspill-data

# Where model.onnx + model_card.json live (fetch_model.py writes here).
OILSPILL_MODELS_DIR=

# Database. SQLite locally, Postgres+PostGIS in production.
DATABASE_URL=sqlite:///./oilspill.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require

# CORS origin for the API (frontend origin).
FRONTEND_ORIGIN=http://localhost:5173

# GitHub release to fetch model artifacts from (owner/repo).
OILSPILL_MODEL_REPO=
OILSPILL_MODEL_TAG=

# Optional: Google Earth Engine fallback (Phase 1 fallback only).
GEE_PROJECT=
